<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <participant profile_name="adaptive_value_workload_participant" is_default_profile="true">
            <rtps>
                <builtin>
                    <readerHistoryMemoryPolicy>PREALLOCATED_WITH_REALLOC</readerHistoryMemoryPolicy>
                    <writerHistoryMemoryPolicy>PREALLOCATED_WITH_REALLOC</writerHistoryMemoryPolicy>
                </builtin>
                <flow_controller_descriptor_list>
                    <flow_controller_descriptor>
                        <name>adaptive_value_async_adaptive_fc</name>
                        <scheduler>ADAPTIVE_VALUE_UTILITY</scheduler>
                        <period_ms>10</period_ms>
                        <adaptive_min_bytes_per_period>8192</adaptive_min_bytes_per_period>
                        <adaptive_initial_bytes_per_period>24576</adaptive_initial_bytes_per_period>
                        <adaptive_max_bytes_per_period>65536</adaptive_max_bytes_per_period>
                        <adaptive_recovery_steps>14</adaptive_recovery_steps>
                        <adaptive_recovery_probe_windows>10</adaptive_recovery_probe_windows>
                        <adaptive_feedback_slow_ratio_percent>150</adaptive_feedback_slow_ratio_percent>
                        <adaptive_feedback_slow_windows>2</adaptive_feedback_slow_windows>
                        <adaptive_feedback_active_load_percent>50</adaptive_feedback_active_load_percent>
                        <adaptive_decrease_percent>75</adaptive_decrease_percent>
                        <adaptive_oversized_sample_budget_ratio>2</adaptive_oversized_sample_budget_ratio>
                    </flow_controller_descriptor>
                </flow_controller_descriptor_list>
            </rtps>
        </participant>

        <publisher profile_name="adaptive_value_workload_default_writer" is_default_profile="true">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
        </publisher>

        <subscriber profile_name="adaptive_value_workload_default_reader" is_default_profile="true">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
        </subscriber>

        <publisher profile_name="/adaptive/control_cmd">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
            <qos>
                <publishMode>
                    <kind>ASYNCHRONOUS</kind>
                    <flow_controller_name>adaptive_value_async_adaptive_fc</flow_controller_name>
                </publishMode>
            </qos>
            <propertiesPolicy>
                <properties>
                    <property>
                        <name>fastdds.adaptive_retransmission.value_class</name>
                        <value>important</value>
                    </property>
                    <property>
                        <name>fastdds.adaptive_async.observe_old_samples</name>
                        <value>true</value>
                    </property>
                </properties>
            </propertiesPolicy>
        </publisher>

        <publisher profile_name="/adaptive/robot_state">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
            <qos>
                <publishMode>
                    <kind>ASYNCHRONOUS</kind>
                    <flow_controller_name>adaptive_value_async_adaptive_fc</flow_controller_name>
                </publishMode>
            </qos>
            <propertiesPolicy>
                <properties>
                    <property>
                        <name>fastdds.adaptive_retransmission.value_class</name>
                        <value>default</value>
                    </property>
                    <property>
                        <name>fastdds.adaptive_async.observe_old_samples</name>
                        <value>true</value>
                    </property>
                </properties>
            </propertiesPolicy>
        </publisher>

        <publisher profile_name="/adaptive/sensor_snapshot">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
            <qos>
                <publishMode>
                    <kind>ASYNCHRONOUS</kind>
                    <flow_controller_name>adaptive_value_async_adaptive_fc</flow_controller_name>
                </publishMode>
            </qos>
            <propertiesPolicy>
                <properties>
                    <property>
                        <name>fastdds.adaptive_retransmission.value_class</name>
                        <value>replaceable_snapshot</value>
                    </property>
                    <property>
                        <name>fastdds.adaptive_async.observe_old_samples</name>
                        <value>true</value>
                    </property>
                </properties>
            </propertiesPolicy>
        </publisher>

        <subscriber profile_name="/adaptive/control_cmd">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
        </subscriber>

        <subscriber profile_name="/adaptive/robot_state">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
        </subscriber>

        <subscriber profile_name="/adaptive/sensor_snapshot">
            <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
        </subscriber>
    </profiles>
</dds>
